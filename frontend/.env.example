# ============================================================
# Frontend environment — copy to .env.local
# ============================================================

# API base URL. In development, point this at the FastAPI server
# (http://localhost:8000). Leave unset when served by the same backend.
REACT_APP_API_URL=http://localhost:8000

# Auth0 tenant. Defaults to the demo tenant if unset.
# REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
# REACT_APP_AUTH0_CLIENT_ID=your-spa-client-id
