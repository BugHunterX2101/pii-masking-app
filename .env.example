# ============================================================
# Enterprise Privacy Suite — environment configuration
# Copy to .env and fill in values. All variables are optional:
# the app boots with SQLite + defaults if nothing is set.
# ============================================================

# --- Database -----------------------------------------------------------
# PostgreSQL connection string (NeonDB, RDS, etc.). If unset, the app falls
# back to a local SQLite file so it runs out of the box (single instance).
# DATABASE_URL=postgresql://user:password@host:5432/pii_masking

# --- Storage (AWS S3) ---------------------------------------------------
# Required for document/batch/dataset uploads. Text masking works without it.
# AWS_REGION=us-east-2
# S3_BUCKET_NAME=pii-mask-ocr-files
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Async queue (Celery + Redis) ---------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --- Auth0 SSO ----------------------------------------------------------
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# ADMIN_EMAILS=admin@example.com,ceo@example.com
# Optional: enforce JWT audience verification.
# AUTH0_AUDIENCE=your-api-audience
# Optional: signing-keys cache TTL in seconds (default 21600 = 6h).
# JWKS_TTL_SECONDS=21600

# --- Email-provider policy (login security) -----------------------------
# Sign-in is denied for emails that are unverified, disposable, or on a
# domain without an MX record. Override the default lists if needed.
# VERIFIED_EMAIL_PROVIDERS=gmail.com,outlook.com,yahoo.com,protonmail.com
# DISPOSABLE_EMAIL_DOMAINS=mailinator.com,yopmail.com,10minutemail.com

# --- OCR ----------------------------------------------------------------
# Image OCR runs locally via RapidOCR (ONNX) — no cloud API or credentials.

# --- Misc ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins (default: *).
# ALLOWED_ORIGINS=https://app.example.com
# Max upload size in bytes (default 104857600 = 100 MB).
# MAX_UPLOAD_BYTES=104857600
